config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% labels in full
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Booted from the snapshot<br/>marked good" as s0
  state "Broken by update, good<br/>entry kept" as s1
  state "Desktop works, its<br/>snapshot marked good" as s2
  state "Old version, settings in<br/>new format" as s3
  state "Updated again while<br/>broken, good entry kept" as s4
  [*] --> s2
  s2 --> s1 : update breaks the desktop or<br/>power fails during update
  s1 --> s4 : update again while broken
  s1 --> s0 : pick the snapshot marked good<br/>in the boot menu
  s4 --> s0 : pick the snapshot marked good<br/>in the boot menu
  s0 --> s2 : restore and reboot
  s0 --> s3 : restore and reboot, but the<br/>new version migrated settings
  s3 --> s2 : restore the listed home paths
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
