#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<'EOF'
Usage: codex-config-sync --base PATH --live PATH [--check | --dry-run]

Merge a tracked stable Codex config into the writable live config. Values from
the tracked base win; keys that exist only in the live config are preserved.
EOF
}

fail() {
	printf 'codex-config-sync: %s\n' "$1" >&2
	exit 1
}

base_config=""
live_config=""
mode="sync"

while (($# > 0)); do
	case "$1" in
	--base)
		(($# >= 2)) || fail "--base requires a path"
		base_config=$2
		shift 2
		;;
	--live)
		(($# >= 2)) || fail "--live requires a path"
		live_config=$2
		shift 2
		;;
	--check)
		[[ $mode == "sync" ]] || fail "choose only one mode"
		mode="check"
		shift
		;;
	--dry-run)
		[[ $mode == "sync" ]] || fail "choose only one mode"
		mode="dry-run"
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		fail "unknown argument"
		;;
	esac
done

[[ -n $base_config ]] || fail "--base is required"
[[ -n $live_config ]] || fail "--live is required"
[[ -f $base_config ]] || fail "base config does not exist"
[[ ! -L $live_config ]] || fail "live config must be a writable regular file"

for command_name in cat cp dirname jq mkdir mktemp mv rm rmdir yq; do
	command -v "$command_name" >/dev/null 2>&1 || fail "required command is unavailable"
done

validate_toml() {
	yq -p=toml -o=json '.' "$1" >/dev/null 2>&1
}

canonical_toml() {
	yq -p=toml -o=json -I=0 '.' "$1" | jq -S -c '.'
}

validate_base_boundary() {
	yq -p=toml -o=json '.' "$base_config" | jq -e '
    def strings_and_keys:
      if type == "object" then
        to_entries[] | (.key, (.value | strings_and_keys))
      elif type == "array" then
        .[] | strings_and_keys
      elif type == "string" then
        .
      else
        empty
      end;

    (has("projects") | not)
    and (((.hooks // {}) | has("state")) | not)
    and (has("marketplaces") | not)
    and (has("notice") | not)
    and ((((.tui // {}) | has("model_availability_nux"))) | not)
    and ([((.apps // {}) | keys[]) | select(startswith("asdk_app_"))] | length == 0)
    and ([strings_and_keys | select(test("^/(home|tmp)(/|$)"))] | length == 0)
  ' >/dev/null
}

validate_toml "$base_config" || fail "base config is invalid TOML"
validate_base_boundary || fail "base config contains host-local or tool-owned state"

live_dir=$(dirname "$live_config")
temporary_dir=""
if [[ $mode == "sync" ]]; then
	mkdir -p "$live_dir"
	merged_config=$(mktemp "$live_dir/.codex-config-sync.XXXXXX")
else
	temporary_dir=$(mktemp -d)
	merged_config="$temporary_dir/config.toml"
fi
cleanup() {
	if [[ -n ${merged_config:-} && -e $merged_config ]]; then
		rm -f -- "$merged_config"
	fi
	if [[ -n ${temporary_dir:-} && -d $temporary_dir ]]; then
		rmdir -- "$temporary_dir"
	fi
}
trap cleanup EXIT

if [[ -e $live_config ]]; then
	[[ -f $live_config ]] || fail "live config is not a regular file"
	validate_toml "$live_config" || fail "live config is invalid TOML"
	yq eval-all -p=toml -o=toml \
		'select(fileIndex == 0) * select(fileIndex == 1)' \
		"$live_config" "$base_config" >"$merged_config"
	chmod --reference="$live_config" "$merged_config"
else
	cp -- "$base_config" "$merged_config"
	chmod 0600 "$merged_config"
fi

validate_toml "$merged_config" || fail "merged config is invalid TOML"

if [[ -e $live_config ]] && [[ $(canonical_toml "$live_config") == "$(canonical_toml "$merged_config")" ]]; then
	if [[ $mode == "dry-run" ]]; then
		cat "$merged_config"
	else
		printf 'codex-config-sync: up to date\n'
	fi
	exit 0
fi

case "$mode" in
check)
	printf 'codex-config-sync: change required\n'
	exit 0
	;;
dry-run)
	cat "$merged_config"
	exit 0
	;;
sync)
	if [[ -e $live_config ]]; then
		cp -p -- "$live_config" "$live_config.pre-dotfiles"
	fi
	mv -- "$merged_config" "$live_config"
	merged_config=""
	printf 'codex-config-sync: updated live config\n'
	;;
esac
